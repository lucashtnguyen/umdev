{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lucashtnguyen/umdev/schemas/project.schema.json",
  "title": "umdev schema version 1 supported project configuration",
  "description": "Author Lucas HT Nguyen; contact https://github.com/lucashtnguyen; date 2026-10-16. Structural contract; Python semantic validation additionally checks engineering policies, references, units and driver capabilities.",
  "type": "object",
  "required": [
    "schema_version",
    "kind"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "umdev_project"
    },
    "extends": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "contact": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    },
    "datasets": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/dataset"
      }
    },
    "units": {
      "type": "object"
    },
    "model": {
      "type": "object"
    },
    "identity": {
      "type": "object"
    },
    "ports": {
      "type": "object",
      "properties": {
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "dataset", "parser"],
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string"},
              "dataset": {"type": "string"},
              "parser": {"enum": ["normalized_port_row_v1", "elevation_direction_diameter_v1", "qualified_elevation_direction_diameter_v1"]},
              "field": {"type": "string"},
              "role": {"enum": ["in", "out", "inlet", "outlet"]},
              "units": {"type": "object", "properties": {"elevation": {"type": "string"}, "diameter": {"type": "string"}}, "additionalProperties": false}
            }
          }
        },
        "assignment": {
          "type": "object",
          "properties": {
            "observation_holds": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "expected_fingerprint",
                  "reason",
                  "reviewer",
                  "date"
                ],
                "properties": {
                  "expected_fingerprint": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reviewer": {
                    "type": "string",
                    "minLength": 1
                  },
                  "date": {
                    "type": "string",
                    "format": "date"
                  }
                }
              }
            },
            "observation_pipe_references": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": ["pipe_key", "basis"],
                "additionalProperties": false,
                "properties": {"pipe_key": {"type": "string", "minLength": 1}, "basis": {"type": "string", "minLength": 1}}
              }
            },
            "relative_offset_frames": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "node_key",
                  "frame_id",
                  "basis",
                  "reviewer",
                  "reference_observation_key",
                  "node_source_sha256",
                  "date",
                  "observations",
                  "endpoints"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "node_key": {
                    "type": "string",
                    "minLength": 1
                  },
                  "frame_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reviewer": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reference_observation_key": {
                    "type": "string",
                    "minLength": 1
                  },
                  "node_source_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "date": {
                    "type": "string",
                    "format": "date"
                  },
                  "observations": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "observation_key",
                        "expected_fingerprint"
                      ],
                      "properties": {
                        "observation_key": {
                          "type": "string",
                          "minLength": 1
                        },
                        "expected_fingerprint": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        }
                      }
                    }
                  },
                  "endpoints": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "observation_key",
                        "pipe_key",
                        "pipe_source_sha256",
                        "end"
                      ],
                      "properties": {
                        "observation_key": {
                          "type": "string",
                          "minLength": 1
                        },
                        "pipe_key": {
                          "type": "string",
                          "minLength": 1
                        },
                        "pipe_source_sha256": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        },
                        "end": {
                          "enum": [
                            "upstream",
                            "downstream"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            },
            "precedence": {
              "type": "array",
              "items": {
                "enum": [
                  "reviewed_override",
                  "pipe_numeric",
                  "normalized_port",
                  "inline_port"
                ]
              }
            }
          }
        }
      }
    },
    "elevations": {
      "type": "object"
    },
    "parameters": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "object",
          "properties": {
            "floor_methods": {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  "reviewed_override",
                  "lowest_structure_port",
                  "lowest_applied_pipe_end",
                  "structure_floor",
                  "unique_active_outgoing_port",
                  "lowest_active_port",
                  "minimum_active_port"
                ]
              }
            }
          }
        }
      }
    },
    "roughness": {
      "type": "object"
    },
    "scenarios": {
      "type": "object"
    },
    "selection": {
      "type": "object"
    },
    "qa": {
      "type": "object"
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ledger_path": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^$|\\S"
        },
        "overrides_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "overrides": {
          "type": "array"
        },
        "changed_evidence": {
          "enum": [
            "mark_stale_and_re_evaluate",
            "hold"
          ]
        },
        "extensions": {
          "type": "object"
        }
      }
    },
    "publication": {
      "type": "object"
    },
    "extensions": {
      "type": "object"
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "format",
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "format": {
          "enum": [
            "json_packet",
            "json",
            "csv",
            "geojson",
            "geopackage",
            "file_geodatabase"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "read_only": {
          "const": true
        },
        "encoding": {
          "type": "string"
        },
        "delimiter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1
        },
        "extensions": {
          "type": "object"
        }
      }
    },
    "field": {
      "type": "object",
      "required": [
        "source",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string"
        },
        "type": {
          "enum": [
            "identifier",
            "number",
            "string"
          ]
        },
        "trim": {
          "type": "boolean"
        },
        "missing": {
          "type": "array"
        },
        "zero_is_missing": {
          "type": "boolean"
        },
        "unit": {
          "enum": [
            "m",
            "mm",
            "in",
            "ft",
            "us_survey_ft",
            "dimensionless",
            "degrees"
          ]
        },
        "extensions": {
          "type": "object"
        }
      }
    },
    "dataset": {
      "type": "object",
      "required": [
        "source",
        "entity",
        "id_field",
        "fields"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string"
        },
        "table": {
          "type": [
            "string",
            "null"
          ]
        },
        "entity": {
          "enum": [
            "pipe",
            "node",
            "port"
          ]
        },
        "id_field": {
          "type": "string"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/field"
          },
          "description": "Canonical identity and parameter names plus arbitrary ASCII identifier text fields explicitly referenced by an inline port observation for this dataset. Semantic validation rejects unknown unreferenced names."
        },
        "filters": {
          "type": "array"
        },
        "domains": {
          "type": "object"
        },
        "geometry": {
          "type": "object"
        },
        "vertical_datum": {
          "type": "string"
        },
        "extensions": {
          "type": "object"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "review"
        ],
        "properties": {
          "review": {
            "required": [
              "ledger_path"
            ],
            "properties": {
              "ledger_path": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "review": {
            "properties": {
              "overrides_path": {
                "enum": [
                  null,
                  ""
                ]
              },
              "overrides": {
                "maxItems": 0
              }
            }
          },
          "model": {
            "properties": {
              "changes_path": {
                "enum": [
                  null,
                  ""
                ]
              }
            }
          }
        }
      }
    }
  ]
}
